# The Movie Database (TMDB). Chave de API v3 gratuita: https://www.themoviedb.org/settings/api
# O site é estático e chama o TMDB direto do navegador, então esta chave fica visível no
# código publicado: use uma chave só de leitura. No GitHub Pages ela vem do secret TMDB_API_KEY.
NEXT_PUBLIC_TMDB_API_KEY=
# Alternativa: Access Token v4 (Bearer).
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=

# OMDb (notas do IMDb e Metacritic), opcional. Chave gratuita: https://www.omdbapi.com/apikey.aspx
NEXT_PUBLIC_OMDB_API_KEY=
